OPENROUTER_API_KEY=              # https://openrouter.ai/keys

# Bearer key for the owner's native clients (iOS app). Any long random string.
# Generate one with: openssl rand -base64 32 | tr -d '=+/'
CLIENT_API_KEY=

TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_WEBHOOK_SECRET_TOKEN=   # any secret you choose
TELEGRAM_ALLOWED_USER_IDS=       # your Telegram user id; nobody else can use the bot
TELEGRAM_VOICE_REPLY=always      # "off" to reply in text only

# Voice notes in and out — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=             # must be a premade voice on the free plan
ELEVENLABS_MODEL_ID=             # defaults to eleven_multilingual_v2

# Web search — https://app.tavily.com
TAVILY_API_KEY=

# Google (Calendar + Gmail) — OAuth client with a refresh token for your account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
