OPENROUTER_API_KEY=              # https://openrouter.ai/keys

# Local time used to resolve "today", "tomorrow", calendar times, etc.
CLAUDIO_TIME_ZONE=Europe/Madrid

# Bearer key for the owner's native clients (iOS app). Any long random string.
# Generate one with: openssl rand -base64 32 | tr -d '=+/'
CLIENT_API_KEY=

TELEGRAM_BOT_TOKEN=              # from @BotFather
TELEGRAM_WEBHOOK_SECRET_TOKEN=   # any secret you choose
TELEGRAM_ALLOWED_USER_IDS=       # your Telegram user id; nobody else can use the bot
TELEGRAM_VOICE_REPLY=always      # "off" to reply in text only

# Voice notes in and out — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=             # must be a premade voice on the free plan
ELEVENLABS_MODEL_ID=             # Telegram voice notes; defaults to eleven_multilingual_v2
ELEVENLABS_APP_MODEL_ID=         # iOS app sentence streaming; defaults to eleven_flash_v2_5 (eleven_v3 in production)
ELEVENLABS_STT_MODEL_ID=         # speech-to-text; defaults to scribe_v2

# Web search — https://app.tavily.com
TAVILY_API_KEY=

# Long-term memory — Upstash Redis via the Vercel Marketplace (`vercel integration add upstash/upstash-kv`).
# Vercel injects these; locally run `vercel env pull .env.local`. Without them memory is in-process only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
